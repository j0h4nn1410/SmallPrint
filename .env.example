# Backend (uvicorn server.main:app --app-dir backend). Without OPENAI_API_KEY the server runs in
# MOCK MODE and serves fixtures/*.json: never deploy the demo without it.
OPENAI_API_KEY=
# Search fallback (S6) when the browser couldn't fetch a T&C page. Unset = no fallback.
TAVILY_API_KEY=
# Companies House exact-name lookup, the last step of the company matcher (J5). Unset = step skipped.
COMPANIES_HOUSE_API_KEY=
# Per-install daily LLM spend limit in USD (S4). Default 0.20. demo/DEMO.md raises it for the pitch.
SMALLPRINT_DAILY_LIMIT_USD=0.20
# Pre-warm (S7): scripts/prewarm.py sends this key to get its own, higher daily limit. Leave unset to disable.
SMALLPRINT_PREWARM_KEY=
SMALLPRINT_PREWARM_LIMIT_USD=5.00
# Refill cost (S8) is GATED: set to 1 only if scripts/refill_gate.py passes (7 of 10) at H10.
SMALLPRINT_REFILL=0
# Company deep search (ADR 0003): on by default; set to 0 for the exact-only matcher.
SMALLPRINT_DEEP_SEARCH=
# "In the news" company records (ADR 0004): on by default when OPENAI_API_KEY and TAVILY_API_KEY
# are set; set to 0 to turn off. Quotes only from the fixed outlet list in backend/smallprint/news.py.
SMALLPRINT_NEWS=
# Mock mode only: "fixture" serves the fixture's company card instead of the live lookup (offline demo).
SMALLPRINT_COMPANY_LOOKUP=
# Where POST /flag/company-match stores reports. Default data/flags.sqlite.
FLAGS_DB=

# Extension build (cd extension && npm run build): backend base URL baked into the build.
# Default https://smallprint-production.up.railway.app; the panel's Settings can override it at runtime.
VITE_SERVER_URL=
